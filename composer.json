{
  "name": "lady/flocpress-builder",
  "description": "Page builder theo SOLID, PSR-4, PSR-11, FLOCSS",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "FlocpressBuilder\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "FlocpressBuilder\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}