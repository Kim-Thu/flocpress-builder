{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-class-pattern": [
      "^((l|c|p|u)-[a-z0-9]+(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?|(is|has)-[a-z0-9]+(-[a-z0-9]+)*|js-[a-z0-9]+(-[a-z0-9]+)*)$",
      { "message": "Class phai theo FLOCSS: l-/c-/p-/u- + BEM, hoac is-/has-/js-" }
    ],
    "selector-max-id": 0,
    "custom-property-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      { "message": "CSS variable dung kebab-case thuong" }
    ],
    "import-notation": "string",
    "max-nesting-depth": 1,
    "declaration-no-important": [true, { "severity": "warning" }]
  },
  "overrides": [
    {
      "files": ["assets/css/object/utility/**/*.css"],
      "rules": { "declaration-no-important": null }
    }
  ]
}